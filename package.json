{
  "name": "codeartifact-login",
  "version": "0.0.0-development",
  "description": "log into AWS CodeArtifact without AWS CLI",
  "bin": "dist/cli.js",
  "sideEffects": false,
  "scripts": {
    "start": "babel-node --extensions .ts src/cli.ts",
    "tc": "toolchain",
    "toolchain": "toolchain",
    "test": "toolchain test",
    "prepublishOnly": "echo This package is meant to be published by semantic-release from the dist build directory. && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jcoreio/codeartifact-login.git"
  },
  "keywords": [
    "aws",
    "codeartifact"
  ],
  "author": "Andy Edwards",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jcoreio/codeartifact-login/issues"
  },
  "homepage": "https://github.com/jcoreio/codeartifact-login#readme",
  "devDependencies": {
    "@babel/node": "^7.19.1",
    "@jcoreio/toolchain": "^5.10.8",
    "@jcoreio/toolchain-circle": "^5.10.8",
    "@jcoreio/toolchain-esnext": "^5.10.8",
    "@jcoreio/toolchain-mocha": "^5.10.8",
    "@jcoreio/toolchain-semantic-release": "^5.10.8",
    "@jcoreio/toolchain-typescript": "^5.10.8",
    "@types/chai": "^4.3.5",
    "@types/chai-as-promised": "^7.1.5",
    "@types/chai-subset": "^1.3.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "^16.0.0",
    "@types/yargs": "^17.0.35",
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^8.3.0",
    "globals": "^16.0.0",
    "lint-staged": "^15.2.2",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.4.2",
    "tempy": "^1.0.1",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-codeartifact": "^3.988.0",
    "@babel/runtime": "^7.26.0",
    "execa": "^5.0.0",
    "yargs": "^17.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "default": "./dist/index.d.ts"
      },
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.6.5",
  "@jcoreio/toolchain": {
    "migratedVersion": "5.10.8"
  }
}
